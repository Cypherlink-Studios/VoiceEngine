# VoiceEngine Server Configuration Example

# ==============================================================================
# Server Core & Authentication
# ==============================================================================
PORT=3000
HOST=0.0.0.0
# NODE_ENV=production
SECRET_KEY=change-me-to-a-secure-random-secret
ENABLE_DEV_TOKENS=true

# ==============================================================================
# WebRTC / Mediasoup SFU & Multi-Worker Architecture
# ==============================================================================
# Public IPv4 or domain of the voice server that web clients will reach for WebRTC media
ANNOUNCED_IP=127.0.0.1
LISTEN_IP=0.0.0.0

# Number of Mediasoup worker processes (scales across CPU cores, default: 1)
MEDIASOUP_NUM_WORKERS=2

# WebRTC UDP port range allocated across workers (must be opened on firewall/security group)
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# ==============================================================================
# Spatial Proximity Audio (in Minecraft blocks)
# ==============================================================================
MAX_VOICE_DISTANCE=30.0
SNEAK_VOICE_DISTANCE=8.0

# ==============================================================================
# Observability & Watchdog Health Alerts
# ==============================================================================
# Optional Discord webhook URL to receive alerts when Event Loop Lag > 30ms or Worker CPU > 85%
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ==============================================================================
# Media & Paper Plugin Shared Storage (Optional - auto-discovered if not set)
# ==============================================================================
# MEDIA_DIR=/path/to/plugins/VoiceEngine/media
# MEDIA_CACHE_DIR=/path/to/plugins/VoiceEngine/media/cache
MEDIA_MAX_CACHE_SIZE_MB=1024
MEDIA_MAX_CACHE_AGE_DAYS=7

# ==============================================================================
# Custom Binary & Media Extraction Locations (Optional - auto-detected if not set)
# ==============================================================================
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# Path to cookies.txt exported from browser to bypass YouTube bot detection
# YT_COOKIES_PATH=/path/to/cookies.txt

